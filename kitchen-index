<!DOCTYPE html>
<html lang="ja">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width,initial-scale=1.0"
>

<title>
キッチンカー管理
</title>


<link
rel="stylesheet"
href="css/style.css"
>


<!-- =========================
PWA
========================= -->

<link
rel="manifest"
href="kitchen-manifest.json"
>


<meta
name="theme-color"
content="#4CAF50"
>


<meta
name="mobile-web-app-capable"
content="yes"
>


<meta
name="apple-mobile-web-app-capable"
content="yes"
>


<meta
name="apple-mobile-web-app-title"
content="キッチンカー"
>


<link
rel="apple-touch-icon"
href="icons/kitchen-192.png"
>


</head>


<body>


<header>

<div class="container header-inner">

<h1>
キッチンカー
</h1>

</div>

</header>



<main class="container">


<div class="shop-info-card">


<h2>
業務メニュー
</h2>


<a
href="kitchen.html"

class="header-btn"

style="
display:block;
padding:30px;
margin:20px 0;
text-align:center;
font-size:24px;
border-radius:10px;
"
>

🛒 注文受付

</a>



<a
href="kitchen-sales.html"

class="header-btn"

style="
display:block;
padding:30px;
margin:20px 0;
text-align:center;
font-size:24px;
border-radius:10px;
"
>

💰 会計確認

</a>


</div>



<div class="shop-info-card">


<h2>
車両情報
</h2>


<p>
車両：
<select id="carNumber">

<option>
1号車
</option>

<option>
2号車
</option>

</select>
</p>


</div>



</main>





<!-- =========================
Service Worker
========================= -->

<script>

if(
"serviceWorker" in navigator
){

window.addEventListener(
"load",
()=>{

navigator.serviceWorker.register(

"kitchen-service-worker.js"

)

.then(()=>{

console.log(
"Kitchen PWA 登録完了"
);

})

.catch(error=>{

console.error(
"PWA登録失敗",
error
);

});

});

}

</script>



</body>

</html>
